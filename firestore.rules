rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email in [
          "sushen.biswas.aga@gmail.com",
          "sushen.biswas.aga@googlemail.com"
        ]
      );
    }

    function isBookingOwnerData(data) {
      return isSignedIn() && (
        data.userId == request.auth.uid ||
        data.uid == request.auth.uid
      );
    }

    function isPendingBookingData(data) {
      return data.status == "pending" &&
        data.requestStatus == "pending" &&
        data.bookingStatus == "pending";
    }

    match /phases/{phaseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAdmin() || (
        isBookingOwnerData(request.resource.data) &&
        isPendingBookingData(request.resource.data) &&
        request.resource.data.bookingId == bookingId &&
        request.resource.data.id == bookingId
      );
      allow update: if isAdmin() || (
        isBookingOwnerData(resource.data) &&
        isBookingOwnerData(request.resource.data) &&
        isPendingBookingData(request.resource.data) &&
        request.resource.data.bookingId == bookingId &&
        request.resource.data.id == bookingId
      );
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      match /progress/{phaseId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /progress/{phaseId}/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /referralEvents/{eventId} {
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.referredUserId == request.auth.uid ||
        resource.data.referrerId == request.auth.uid
      ));
      allow create, update: if isAdmin() || (isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.referrerId == request.auth.uid
      ));
      allow delete: if isAdmin() || (isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.referredUserId == request.auth.uid ||
        resource.data.referrerId == request.auth.uid
      ));
    }

    match /affiliateStats/{affiliateId} {
      allow read: if isAdmin() || (isSignedIn() && (
        affiliateId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      ));
      allow create, update: if isAdmin() || (isSignedIn() && (
        affiliateId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      ));
      allow delete: if isAdmin() || (isSignedIn() && (
        affiliateId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      ));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
